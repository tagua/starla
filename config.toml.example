# Starla Configuration
#
# Place this file at one of:
#   $CONFIGURATION_DIRECTORY/config.toml  (systemd)
#   $XDG_CONFIG_HOME/starla/config.toml
#   /etc/starla/config.toml               (root)
#   ~/.config/starla/config.toml          (non-root)
#
# State directory (keys, probe_id, known_hosts):
#   --state-dir CLI flag > $STATE_DIRECTORY > $XDG_STATE_HOME/starla
#   Root: /var/lib/starla, non-root: ~/.local/state/starla

[probe]
# Log level: trace, debug, info, warn, error
log_level = "info"

[network]
# Report network interface traffic statistics (rx/tx bytes, packets, errors)
rxtxrpt = false

# Enable status socket for tray app communication (desktop only)
status_socket = false

[controller]
# Registration servers (host:port)
registration_servers = [
    "reg-05.prod.atlas.ripe.net:443",
    "reg-06.prod.atlas.ripe.net:443"
]

# SSH connection timeout (seconds)
ssh_timeout = 30

# SSH keepalive interval (seconds)
keepalive_interval = 60

[measurements]
# Time replies by the kernel's receive stamps, not by a clock read once the
# probe gets to them. Off by default: the reference probe stamps replies in
# userspace, and turning this on departs from it deliberately.
#
# On (Linux only; ignored elsewhere), ping, traceroute, DNS over UDP and NTP
# take a reply's receive time from SO_TIMESTAMPNS, the kernel's stamp of
# its arrival. Their RTTs then leave out the time a reply waited to be read
# -- a busy or stalled runtime, the scheduler -- so they no longer depend
# on userspace scheduling, and read lower than reference probes' (about
# 10-30 us on an idle host). Send times stay userspace, taken right before
# the send. DNS over TCP, TLS and HTTP keep userspace stamps.
#
# The cost: while it is on, the kernel stamps every packet the host
# receives, not only the probe's (one clock read each).
kernel_rx_timestamps = false

[storage]
# Maximum number of results to hold in the upload queue
max_queue_size = 10000

# Result retention period in days
retention_days = 30

[metrics]
# Enable Prometheus metrics export (requires metrics-export feature)
enabled = true

# Metrics server listen address
listen_addr = "127.0.0.1:9695"

[logging]
# Log format: json or text
format = "json"

# Not yet wired up: file output and rotation are driven by the --log-dir
# flag, and these three keys are read but ignored. Tracked separately from
# `format` and `[probe] log_level`, which do take effect.
output = "stdout"
max_file_size_mb = 10
max_files = 5
